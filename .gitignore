# Dependencies
node_modules/

# Build output
dist/

# Rust/Tauri build output (also in src-tauri/.gitignore)
src-tauri/target/
src-tauri/gen/schemas

# Environment and secrets
.env
.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Playwright
.playwright-mcp/
test-results/
playwright-report/

# TypeScript build info
*.tsbuildinfo

# Claude Code user-specific files (keep project .claude/settings.json tracked)
.claude/memory/
.claude/worktrees/
.agents/

# MCP server config (local, may contain API keys)
.mcp.json
screenshots/

# Scratch notes
scratch/

# Design/planning docs (brainstorming artifacts, not shipped)
docs/plans/
src-tauri/models/

# Session handoff notes (local scratch; keep parity-checklist.md tracked)
docs/session-*.md
docs/issue-triage-*.md

# Desktop bundle output collected by .github/workflows/build.yml
/artifacts/

# Docs site build output (zensical) + its incremental build cache
/site/
/.cache/
